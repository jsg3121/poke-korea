# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# service account keys — 저장소 밖(~/.config/poke-korea/)에 두는 것이 원칙이나,
# 실수로 옮겨왔을 때를 대비한 방어선 (.claude/analyzer/index.md 참조)
*service-account*.json
gcp-*.json

# OAuth 클라이언트 시크릿 / 리프레시 토큰 (애드센스 API)
# 애드센스는 서비스 계정을 지원하지 않아 OAuth 사용자 인증을 쓴다. 리프레시 토큰은
# 만료 없이 계정 데이터에 접근할 수 있어 서비스 계정 키와 동급으로 취급한다.
# 스크립트(.claude/analyzer/scripts/*.js)는 경로만 참조하므로 정상 커밋된다.
*oauth*.json
*-client.json
client_secret*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/graphql

# claude analyzer data (sensitive)
/.claude/analyzer/*.*

# playwright screenshots
/.claude/playwright

# api handoff documents (from external backend repo)
/.claude/api-handoffs

# design system card sources (uploaded to claude.ai/design, not version-controlled)
/.design-system

*storybook.log
storybook-static

# UI 시안 미리보기 (ui-publisher 산출물, 커밋 금지 — 임시 확인용)
/public/preview
